<section class="testimonial d-flex flex-column justify-content-center">
    <div id="carouselExampleIndicators" class="my-3 carousel slide w-sm-75">
        <div class="carousel-indicators z-1">

            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>

            <% testimonials.forEach((testimonial, index) => { %>
                <% if (index !== 0) { %>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="<%= index %>" ></button>
                <% } %>
            <% }) %>
            
        </div>
        <div class="carousel-inner my-3">
            <h1>Testimonials</h1>

            <div class="carousel-item text-white active text-white">
                <div class="container testimonial-container">
                    <img src="./img/testimonials/<%= `testimonialProfilePic1` %>.png" alt="Avatar" style="width:90px;">
                    <h3><%= testimonials[0].testimonialName %></h3>
                    <h5><%= testimonials[0].testimonialDesignation %></h5>
                    <p class="text-start review text-start"><%= testimonials[0].testimonialParagraph %></p>
                </div>
            </div>

            <% testimonials.forEach((testimonial, index) => { %>
                <% if (index !== 0) { %>
                <div class="carousel-item text-white text-white">
                    <div class="container testimonial-container">
                        <img src="./img/testimonials/<%= `testimonialProfilePic1` %>.png" alt="Avatar" style="width:90px;">
                        <h3><%= testimonial.testimonialName %></h3>
                        <h5><%= testimonial.testimonialDesignation %></h5>
                        <p class="text-start review text-start"><%= testimonial.testimonialParagraph %></p>
                    </div>
                </div>
                <% } %>
            <% }) %>

            
            
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
    </div>

    <div class="container mt-5 mb-5 text-center">
        <h3>Want to Submit a Testimonial?</h3>
        <p>Click the button below to go to the testimonial submission page.</p>
        <a href="/testimonial-form" class="btn btn-link fs-4">Go to Testimonial Form ↗</a>
    </div>

</section>