<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testimonials</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h2 class="mb-4 text-center">User Testimonials</h2>
        <div class="row d-flex flex-column align-items-center">
            
            <% testimonialJson.forEach((testimonial) => { %>
                <div class="card mb-3" style="width: 100%; max-width: 500px;" id="_<%= testimonial.bufferID %>">
                    <div class="row g-0 align-items-center">
                        <div class="col-md-3 text-center p-2">
                            <img src="/img/testimonials/testimonialProfilePic1.png" class="rounded-circle" style="height: 60px; width: 60px;" alt="Profile Photo">
                        </div>
                        <div class="col-md-9">
                            <div class="card-body">
                                <h5 class="card-title"> <%= testimonial.testimonialName %> </h5>
                                <h6 class="card-subtitle mb-2 text-muted"> <%= testimonial.testimonialDesignation %> </h6>
                                <p class="card-text"> <%= testimonial.testimonialParagraph %> </p>
                                <button class="btn btn-success" onclick="sendTransferAndDeleteTestimonialAPIRequest('<%=testimonial.bufferID%>')">Approve</button>
                                <button class="btn btn-danger" onclick="sendDeleteTestimonialAPIRequest('<%=testimonial.bufferID%>')">Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>

            
            
            
            
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function sendDeleteTestimonialAPIRequest(testimonialID) {
            const response = await fetch('/user/testimonial-approval', {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ bufferID: testimonialID }) // Sending bufferID in the request body
            })

            if (response.status === 200) {
                document.querySelector(`#_${testimonialID}`).remove()
                // window.alert("successfull")
            }


        }
    </script>
</body>
</html>
